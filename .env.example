# Copy this file to .env. Never commit the real sandbox secret.
CONTROLLED_CUSTODY_PROVIDER=paypal_sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_RETURN_URL=https://example.com/paypal/return
PAYPAL_CANCEL_URL=https://example.com/paypal/cancel

# Optional grounded AI guidance. Leave disabled for deterministic local guidance.
CONTROLLED_AI_PROVIDER=disabled
CONTROLLED_AI_BASE_URL=https://openrouter.ai/api/v1
CONTROLLED_AI_MODEL=your-structured-output-model
CONTROLLED_AI_API_KEY=your-provider-api-key
CONTROLLED_AI_TIMEOUT=12s
CONTROLLED_AI_REQUIRE_PARAMETERS=true
